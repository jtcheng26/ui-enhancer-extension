{
  "root": {
    "selector": "div.ic-DashboardCard__box__container",
    "required": true,
    "output": "DashboardCards"
  },
  "extractors": {
    "DashboardCards": {
      "cards": {
        "kind": "list",
        "selectors": [
          "div.ic-DashboardCard[data-testid='draggable-card']",
          "div.ic-DashboardCard"
        ],
        "item": "DashboardCard",
        "limit": 20,
        "unique": true
      }
    },
    "DashboardCard": {
      "courseName": {
        "kind": "value",
        "sources": [
          {
            "type": "attr",
            "selectors": [
              "h2.ic-DashboardCard__header-title[title]",
              "h2[data-testid='dashboard-card-title'][title]"
            ],
            "attr": "title",
            "transform": [
              {
                "fn": "trim"
              }
            ]
          },
          {
            "type": "text",
            "selectors": [
              "h2.ic-DashboardCard__header-title",
              "h2[data-testid='dashboard-card-title']"
            ],
            "transform": [
              {
                "fn": "trim"
              }
            ]
          }
        ],
        "nullable": false
      },
      "courseCode": {
        "kind": "value",
        "sources": [
          {
            "type": "attr",
            "selectors": ["div.ic-DashboardCard__header-subtitle[title]"],
            "attr": "title",
            "transform": [
              {
                "fn": "trim"
              }
            ]
          },
          {
            "type": "text",
            "selectors": ["div.ic-DashboardCard__header-subtitle"],
            "transform": [
              {
                "fn": "trim"
              }
            ]
          }
        ],
        "nullable": true
      },
      "courseUrl": {
        "kind": "value",
        "sources": [
          {
            "type": "attr",
            "selectors": ["a.ic-DashboardCard__link[href]"],
            "attr": "href",
            "transform": [
              {
                "fn": "trim"
              }
            ]
          }
        ],
        "nullable": false
      },
      "cardAriaLabel": {
        "kind": "value",
        "sources": [
          {
            "type": "attr",
            "selectors": ["div.ic-DashboardCard[aria-label]"],
            "attr": "aria-label",
            "transform": [
              {
                "fn": "trim"
              }
            ]
          }
        ],
        "nullable": true
      },
      "imageUrl": {
        "kind": "value",
        "sources": [
          {
            "type": "attr",
            "selectors": ["div.ic-DashboardCard__header_image[style]"],
            "attr": "style",
            "transform": [
              {
                "fn": "trim"
              },
              {
                "fn": "replace",
                "pattern": "^.*url\\([\"']?",
                "with": "",
                "flags": "i"
              },
              {
                "fn": "replace",
                "pattern": "[\"']?\\).*",
                "with": "",
                "flags": "i"
              }
            ]
          }
        ],
        "nullable": true
      },
      "color": {
        "kind": "value",
        "sources": [
          {
            "type": "attr",
            "selectors": ["div.ic-DashboardCard__header_hero[style]"],
            "attr": "style",
            "transform": [
              {
                "fn": "trim"
              },
              {
                "fn": "replace",
                "pattern": "^.*background-color:\\s*",
                "with": "",
                "flags": "i"
              },
              {
                "fn": "replace",
                "pattern": ";.*$",
                "with": "",
                "flags": "i"
              }
            ]
          }
        ],
        "nullable": true
      },
      "actions": {
        "kind": "list",
        "selectors": [
          "nav.ic-DashboardCard__action-container > a.ic-DashboardCard__action",
          "nav.ic-DashboardCard__action-container a.ic-DashboardCard__action"
        ],
        "item": "DashboardAction",
        "limit": 5,
        "unique": true
      },
      "moreMenuExpanded": {
        "kind": "value",
        "sources": [
          {
            "type": "attr",
            "selectors": [
              "button.ic-DashboardCard__header-button[aria-expanded]"
            ],
            "attr": "aria-expanded",
            "transform": [
              {
                "fn": "trim"
              },
              {
                "fn": "lowercase"
              }
            ]
          },
          {
            "type": "exists",
            "selectors": ["button.ic-DashboardCard__header-button"],
            "filter": {
              "hasChild": "i.icon-more"
            }
          }
        ],
        "nullable": true
      },
      "moreMenuButtonLabel": {
        "kind": "value",
        "sources": [
          {
            "type": "text",
            "selectors": [
              "button.ic-DashboardCard__header-button .screenreader-only"
            ],
            "transform": [
              {
                "fn": "trim"
              }
            ]
          }
        ],
        "nullable": true
      },
      "hasAnnouncementsAction": {
        "kind": "value",
        "sources": [
          {
            "type": "exists",
            "selectors": [
              "nav.ic-DashboardCard__action-container a.ic-DashboardCard__action.announcements"
            ],
            "filter": {}
          }
        ],
        "nullable": false
      },
      "hasAssignmentsAction": {
        "kind": "value",
        "sources": [
          {
            "type": "exists",
            "selectors": [
              "nav.ic-DashboardCard__action-container a.ic-DashboardCard__action.assignments"
            ],
            "filter": {}
          }
        ],
        "nullable": false
      },
      "hasDiscussionsAction": {
        "kind": "value",
        "sources": [
          {
            "type": "exists",
            "selectors": [
              "nav.ic-DashboardCard__action-container a.ic-DashboardCard__action.discussions"
            ],
            "filter": {}
          }
        ],
        "nullable": false
      },
      "hasFilesAction": {
        "kind": "value",
        "sources": [
          {
            "type": "exists",
            "selectors": [
              "nav.ic-DashboardCard__action-container a.ic-DashboardCard__action.files"
            ],
            "filter": {}
          }
        ],
        "nullable": false
      },
      "actionCount": {
        "kind": "derive",
        "from": "actions",
        "fn": "arrayLength"
      }
    },
    "DashboardAction": {
      "actionType": {
        "kind": "value",
        "sources": [
          {
            "type": "attr",
            "selectors": ["a.ic-DashboardCard__action[title]"],
            "attr": "title",
            "transform": [
              {
                "fn": "trim"
              },
              {
                "fn": "replace",
                "pattern": "\\s*-\\s*.*$",
                "with": "",
                "flags": "i"
              }
            ]
          },
          {
            "type": "attr",
            "selectors": ["a.ic-DashboardCard__action[href]"],
            "attr": "href",
            "transform": [
              {
                "fn": "trim"
              },
              {
                "fn": "replace",
                "pattern": "^/courses/\\d+/",
                "with": "",
                "flags": "i"
              },
              {
                "fn": "replace",
                "pattern": "[/?#].*$",
                "with": "",
                "flags": "i"
              }
            ]
          }
        ],
        "nullable": false
      },
      "actionTitle": {
        "kind": "value",
        "sources": [
          {
            "type": "attr",
            "selectors": ["a.ic-DashboardCard__action[title]"],
            "attr": "title",
            "transform": [
              {
                "fn": "trim"
              }
            ]
          },
          {
            "type": "text",
            "selectors": ["a.ic-DashboardCard__action .screenreader-only"],
            "transform": [
              {
                "fn": "trim"
              }
            ]
          }
        ],
        "nullable": true
      },
      "href": {
        "kind": "value",
        "sources": [
          {
            "type": "attr",
            "selectors": ["a.ic-DashboardCard__action[href]"],
            "attr": "href",
            "transform": [
              {
                "fn": "trim"
              }
            ]
          }
        ],
        "nullable": false
      },
      "badgeCount": {
        "kind": "value",
        "sources": [
          {
            "type": "text",
            "selectors": ["a.ic-DashboardCard__action .unread_count"],
            "transform": [
              {
                "fn": "trim"
              },
              {
                "fn": "parseNumber"
              }
            ]
          },
          {
            "type": "static",
            "value": 0
          }
        ],
        "nullable": false
      },
      "hasUnreadBadge": {
        "kind": "value",
        "sources": [
          {
            "type": "exists",
            "selectors": ["a.ic-DashboardCard__action .unread_count"],
            "filter": {}
          }
        ],
        "nullable": false
      }
    }
  }
}
