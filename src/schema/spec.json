{
  "elements": {
    "action-show-all": {
      "children": [],
      "props": {
        "label": {
          "$state": "/showAllLabel"
        },
        "variant": "secondary"
      },
      "type": "Button"
    },
    "action-start-course": {
      "children": [],
      "on": {
        "press": {
          "action": "setState",
          "params": {
            "statePath": "/createCourseModalExists",
            "value": true
          }
        }
      },
      "props": {
        "label": {
          "$state": "/startNewCourseLabel"
        },
        "variant": "primary"
      },
      "type": "Button"
    },
    "action-view-grades": {
      "children": [],
      "props": {
        "label": {
          "$state": "/viewGradesLabel"
        },
        "variant": "secondary"
      },
      "type": "Button"
    },
    "feedback-card": {
      "children": ["feedback-separator", "feedback-list-stack"],
      "props": {
        "className": "border-emerald-200 bg-white/90 shadow-sm",
        "description": "Kind words from your teacher.",
        "maxWidth": "full",
        "title": "Proud notes"
      },
      "type": "Card",
      "visible": {
        "$state": "/hasRecentFeedback"
      }
    },
    "feedback-item-badge": {
      "children": [],
      "props": {
        "text": "Teacher cheer",
        "variant": "outline"
      },
      "type": "Badge"
    },
    "feedback-item-card": {
      "children": ["feedback-item-stack"],
      "props": {
        "className": "border-emerald-100 bg-emerald-50/70 shadow-sm",
        "maxWidth": "full"
      },
      "type": "Card"
    },
    "feedback-item-stack": {
      "children": ["feedback-item-badge", "feedback-item-text"],
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "type": "Stack"
    },
    "feedback-item-text": {
      "children": [],
      "props": {
        "text": {
          "$item": "text"
        },
        "variant": "body"
      },
      "type": "Text"
    },
    "feedback-list-stack": {
      "children": ["feedback-item-card"],
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "repeat": {
        "key": "text",
        "statePath": "/recentFeedback"
      },
      "type": "Stack"
    },
    "feedback-separator": {
      "children": [],
      "props": {
        "orientation": "horizontal"
      },
      "type": "Separator"
    },
    "hero-alert": {
      "children": [],
      "props": {
        "message": "Choose one card and start there.",
        "title": "Tiny steps win!",
        "type": "info"
      },
      "type": "Alert"
    },
    "hero-badge": {
      "children": [],
      "props": {
        "text": "Star time",
        "variant": "outline"
      },
      "type": "Badge"
    },
    "hero-card": {
      "children": ["hero-stack"],
      "props": {
        "className": "border-sky-200 bg-white/90 shadow-sm",
        "maxWidth": "full"
      },
      "type": "Card"
    },
    "hero-heading": {
      "children": [],
      "props": {
        "level": "h1",
        "text": "Homework Quest"
      },
      "type": "Heading"
    },
    "hero-stack": {
      "children": ["hero-badge", "hero-heading", "hero-subtitle", "hero-alert"],
      "props": {
        "align": "start",
        "direction": "vertical",
        "gap": "sm"
      },
      "type": "Stack"
    },
    "hero-subtitle": {
      "children": [],
      "props": {
        "text": "Pick one tiny task, earn shiny stars, and feel proud.",
        "variant": "lead"
      },
      "type": "Text"
    },
    "page": {
      "children": [
        "hero-card",
        "quick-actions-card",
        "start-course-dialog",
        "quest-board-card",
        "feedback-card"
      ],
      "props": {
        "className": "mx-auto min-h-screen w-full max-w-4xl bg-gradient-to-br from-sky-50 via-white to-amber-50 p-4 md:p-8",
        "direction": "vertical",
        "gap": "xl"
      },
      "type": "Stack"
    },
    "quest-board-card": {
      "children": ["quest-board-separator", "todo-list-stack"],
      "props": {
        "className": "border-indigo-200 bg-white/90 shadow-sm",
        "description": "A playful check-off list for today.",
        "maxWidth": "full",
        "title": "Your quest board"
      },
      "type": "Card",
      "visible": {
        "$state": "/hasToDo"
      }
    },
    "quest-board-separator": {
      "children": [],
      "props": {
        "orientation": "horizontal"
      },
      "type": "Separator"
    },
    "quick-actions-card": {
      "children": ["quick-actions-stack"],
      "props": {
        "className": "border-amber-200 bg-white/90 shadow-sm",
        "description": "Tap to switch gears or start something fresh.",
        "maxWidth": "full",
        "title": "Quick actions"
      },
      "type": "Card"
    },
    "quick-actions-stack": {
      "children": [
        "action-start-course",
        "action-view-grades",
        "action-show-all"
      ],
      "props": {
        "className": "flex-wrap",
        "direction": "horizontal",
        "gap": "sm"
      },
      "type": "Stack"
    },
    "start-course-dialog": {
      "children": ["start-course-dialog-stack"],
      "props": {
        "description": "Choose a fresh learning quest.",
        "openPath": "/createCourseModalExists",
        "title": "Start a new adventure"
      },
      "type": "Dialog"
    },
    "start-course-dialog-badge": {
      "children": [],
      "props": {
        "text": "New quest unlocked",
        "variant": "default"
      },
      "type": "Badge"
    },
    "start-course-dialog-close": {
      "children": [],
      "on": {
        "press": {
          "action": "setState",
          "params": {
            "statePath": "/createCourseModalExists",
            "value": false
          }
        }
      },
      "props": {
        "label": "Maybe later",
        "variant": "secondary"
      },
      "type": "Button"
    },
    "start-course-dialog-stack": {
      "children": [
        "start-course-dialog-text",
        "start-course-dialog-badge",
        "start-course-dialog-close"
      ],
      "props": {
        "align": "start",
        "direction": "vertical",
        "gap": "md"
      },
      "type": "Stack"
    },
    "start-course-dialog-text": {
      "children": [],
      "props": {
        "text": "Ready for a brand-new quest? Pick a subject you like and begin with one tiny step.",
        "variant": "lead"
      },
      "type": "Text"
    },
    "todo-item-card": {
      "children": ["todo-item-stack"],
      "props": {
        "className": "border-sky-100 bg-white shadow-sm transition hover:shadow-md",
        "maxWidth": "full"
      },
      "type": "Card"
    },
    "todo-item-course-badge": {
      "children": [],
      "props": {
        "text": {
          "$item": "courseName"
        },
        "variant": "outline"
      },
      "type": "Badge"
    },
    "todo-item-dismiss": {
      "children": [],
      "on": {
        "press": {
          "action": "removeState",
          "params": {
            "index": {
              "$index": true
            },
            "statePath": "/toDo"
          }
        }
      },
      "props": {
        "label": {
          "$item": "dismissLabel"
        },
        "variant": "secondary"
      },
      "type": "Button"
    },
    "todo-item-due-text": {
      "children": [],
      "props": {
        "text": {
          "$item": "dueText"
        },
        "variant": "caption"
      },
      "type": "Text"
    },
    "todo-item-header": {
      "children": ["todo-item-main", "todo-item-points-badge"],
      "props": {
        "align": "start",
        "className": "items-start",
        "direction": "horizontal",
        "gap": "sm",
        "justify": "between"
      },
      "type": "Stack"
    },
    "todo-item-link": {
      "children": [],
      "props": {
        "href": {
          "$item": "href"
        },
        "label": {
          "$item": "title"
        }
      },
      "type": "Link"
    },
    "todo-item-main": {
      "children": ["todo-item-link", "todo-item-meta"],
      "props": {
        "className": "min-w-0",
        "direction": "vertical",
        "gap": "xs"
      },
      "type": "Stack"
    },
    "todo-item-meta": {
      "children": ["todo-item-course-badge", "todo-item-due-text"],
      "props": {
        "className": "flex-wrap",
        "direction": "horizontal",
        "gap": "sm"
      },
      "type": "Stack"
    },
    "todo-item-points-badge": {
      "children": [],
      "props": {
        "text": {
          "$item": "pointsText"
        },
        "variant": "secondary"
      },
      "type": "Badge"
    },
    "todo-item-stack": {
      "children": ["todo-item-header", "todo-item-dismiss"],
      "props": {
        "direction": "vertical",
        "gap": "sm"
      },
      "type": "Stack"
    },
    "todo-list-stack": {
      "children": ["todo-item-card"],
      "props": {
        "direction": "vertical",
        "gap": "md"
      },
      "repeat": {
        "key": "href",
        "statePath": "/toDo"
      },
      "type": "Stack"
    }
  },
  "root": "page",
  "state": {
    "createCourseModalExists": false,
    "hasRecentFeedback": true,
    "hasToDo": true,
    "recentFeedback": [
      {
        "text": "You tried every problem like a brave explorer!"
      },
      {
        "text": "Your reading voice was bright and clear."
      },
      {
        "text": "Amazing job staying focused during science time!"
      }
    ],
    "showAllLabel": "Show all quests",
    "startNewCourseLabel": "Start a new adventure",
    "toDo": [
      {
        "courseName": "Math Magic",
        "dismissButtonType": "secondary",
        "dismissLabel": "Hide for now",
        "dueText": "Due today",
        "href": "https://school.example.com/quests/math-magic",
        "pointsText": "⭐ 10 stars",
        "title": "Count the jellybeans in 3 treasure jars",
        "titleAriaLabel": "Open the Math Magic counting quest"
      },
      {
        "courseName": "Reading Rockets",
        "dismissButtonType": "secondary",
        "dismissLabel": "Snooze",
        "dueText": "Due tomorrow",
        "href": "https://school.example.com/quests/reading-rockets",
        "pointsText": "⭐ 8 stars",
        "title": "Read one story and draw your favorite character",
        "titleAriaLabel": "Open the Reading Rockets story quest"
      },
      {
        "courseName": "Science Safari",
        "dismissButtonType": "secondary",
        "dismissLabel": "Later",
        "dueText": "Due Friday",
        "href": "https://school.example.com/quests/science-safari",
        "pointsText": "⭐ 12 stars",
        "title": "Build a paper airplane and test its wings",
        "titleAriaLabel": "Open the Science Safari build quest"
      }
    ],
    "viewGradesLabel": "View grades"
  }
}
